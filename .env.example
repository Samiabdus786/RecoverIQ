APP_ENV=development
DEMO_MODE=true
DEMO_SEED=42
DATABASE_URL=sqlite:///./recoveriq.db
# Supabase/PostgreSQL example: postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require

GEMINI_API_KEY=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
PAYMENT_PROVIDER=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=change-me

RECOVERY_MAX_ATTEMPTS=2
RECOVERY_MAX_CONTACTS=2
RECOVERY_WINDOW_HOURS=168
MIN_CONTACT_DELAY_MINUTES=30
HIGH_VALUE_APPROVAL_THRESHOLD=25000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
VITE_API_URL=http://localhost:8000/api
